QWidget {
    background-color: #f4f6f8;
    color: #202733;
    font-family: "Segoe UI";
    font-size: 14px;
}

QPushButton {
    background-color: #3977c3;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 9px 16px;
}

QPushButton:hover {
    background-color: #2e65a8;
}

QPushButton:pressed {
    background-color: #244f84;
}

QLabel {
    padding: 4px;
}
